Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# API ir failai – tikri keliai, jiems SPA fallback netaikomas
RewriteRule ^(api|files)(/|$) - [L]

# Vieno puslapio programa: visa kita -> index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
# Programos apvalkalas visada tikrinamas iš naujo
<FilesMatch "^(sw\.js|index\.html|manifest\.json)$">
Header set Cache-Control "no-cache"
</FilesMatch>
# Vite sugeneruoti failai su maiša pavadinime – galima talpinti amžinai
<FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
