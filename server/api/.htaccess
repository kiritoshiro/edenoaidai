<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
</IfModule>

# Šie failai niekada neatiduodami per HTTP
<FilesMatch "^(config\.php|config\.example\.php|hash-password\.php|import-cli\.php)$">
Require all denied
</FilesMatch>
<FilesMatch "\.sql$">
Require all denied
</FilesMatch>
