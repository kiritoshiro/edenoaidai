# Copy this file to /etc/nginx/sites-available/edeno-aidai.conf, or merge the
# directives into the server block generated by Virtualmin.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    root /home/DOMAIN_USER/public_html;
    index index.html;
    charset utf-8;

    client_max_body_size 64m;

    # Route every API request through the only public PHP entry point.
    location = /api {
        rewrite ^ /api/index.php last;
    }

    location ^~ /api/ {
        rewrite ^ /api/index.php last;
    }

    location = /api/index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/api/index.php;
        fastcgi_param SCRIPT_NAME /api/index.php;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    # No other PHP file may be executed or downloaded over HTTP.
    location ~ \.php$ {
        return 404;
    }

    # Runtime storage and hidden files are private. Android Digital Asset Links
    # and ACME challenges remain available under .well-known.
    location ^~ /storage/ {
        deny all;
    }

    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }

    # Vite assets are content-hashed and may be cached for a year.
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Uploaded audio, icons, and sheet music must exist as real files.
    location ^~ /files/ {
        try_files $uri =404;
        expires 7d;
    }

    # Always revalidate the application shell and service worker.
    location ~* ^/(index\.html|sw\.js|manifest\.json|version\.json)$ {
        try_files $uri =404;
        expires -1;
        add_header Cache-Control "no-cache";
    }

    # Vue Router history fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
