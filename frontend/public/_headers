# Hashed build assets can be cached forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and app shell must always be revalidated
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
