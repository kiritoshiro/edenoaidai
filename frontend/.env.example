# Numatytosios reikšmės tuščios = viskas iš to paties serverio
# (frontend, API ir failai viename Virtualmin domene).

# API adresas. Palikite tuščią, jei API tame pačiame domene.
VITE_API_URL=

# Giesmių ir įrašų tipų JSON. Tuščia = /api/public/db.json ir /api/public/tracks.json
VITE_DB_URL=
VITE_TRACKS_URL=

# Bendra failų bazė naudojama kategorijų ikonoms (audio/<tipas>/icon.*).
VITE_FILES_BASE=

# Failų bazės. Tuščia = /files/audio, /files/notes, /files/icons šiame serveryje.
# Jei audio/natos lieka sename adrese, nurodykite pvz.:
# VITE_AUDIO_BASE=https://adventistai.lt/giesmes
# VITE_NOTES_BASE=https://adventistai.lt/giesmes/notes
VITE_AUDIO_BASE=
VITE_NOTES_BASE=
VITE_ICONS_BASE=

# Tik "npm run dev": kur nukreipti /api ir /files užklausas.
# Vietinis PHP: http://localhost:8000  (php -S localhost:8000 router.php iš server/)
# Arba tiesiai į jūsų svetainę: https://jusu-domenas.lt
VITE_PROXY_TARGET=http://localhost:8000
